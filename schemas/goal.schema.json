{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/forefy/.context/schemas/goal.schema.json",
  "title": "Goal goal.v1",
  "description": "YAML frontmatter of a goal.md / *.goal.md file. A goal is the completion contract - end_state, proof, guardrail, termination. How it runs - once via /goal, repeating via /loop, or scheduled via /schedule - is chosen at invocation, never stored in the goal. The allowed_paths-in-condition drift rule is enforced by scripts/schema_check.py, not this schema.",
  "type": "object",
  "required": ["end_state", "proof", "termination"],
  "properties": {
    "kind": { "const": "goal" },
    "schema": { "enum": ["goal.v1"] },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "condition": { "type": "string" },
    "end_state": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "proof": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "guardrail": {
      "type": "object",
      "properties": {
        "invariants": { "type": "array", "items": { "type": "string" } },
        "allowed_paths": { "type": "array", "items": { "type": "string" } }
      }
    },
    "termination": {
      "type": "object",
      "properties": {
        "max_turns": { "type": "integer", "minimum": 1 },
        "max_duration": { "type": "string", "minLength": 1 },
        "stop_on": { "type": "array", "items": { "type": "string" } }
      },
      "anyOf": [
        { "required": ["max_turns"] },
        { "required": ["max_duration"] },
        {
          "required": ["stop_on"],
          "properties": { "stop_on": { "minItems": 1 } }
        }
      ]
    },
    "quality_checklist": {}
  }
}
