# config.example.env - copy to config.local.env and edit for local self-user use only
# One block per guest. GUESTS lists the tags you actually use.
# Props per guest (GUEST_<tag>_<PROP>):
#   PROVIDER  parallels | virtualbox | vmware   (which hypervisor hosts it)
#   OS        macos | windows | linux           (drives toolkit + SSH gotchas)
#   ARCH      arm64 | x64                        (drives tool-download URLs)
#   VMNAME    the VM's name/UUID as the provider knows it (for power/ip/snapshot)
#   IP        pin it, OR leave empty to auto-discover (provider -> mDNS -> ARP)
#   USER      login user on the guest
#   AUTH      key | password
#   KEY       ssh private key path         (AUTH=key)
#   PW        password / sudo password     (AUTH=password, and sudo on mac/linux)
#   HOSTNAME  <name>.local for mDNS discovery fallback   (optional)
#   MAC       guest NIC MAC for ARP-scan discovery fallback (optional)
#   RESET_SNAPSHOT  name/id of the clean snapshot `ctl.sh <tag> reset` restores (optional)

# Which guests are live. Tags are yours to choose.
GUESTS="mac win lin"

# Optional: override the default SSH options (agent-dodge + disposable host keys).
# SSH_OPTS="-o IdentitiesOnly=yes -o IdentityAgent=none -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no -o LogLevel=ERROR -o ConnectTimeout=10"

# Reach the host from inside a guest (network varies by provider; see providers/*.sh):
#   Parallels shared: 10.211.55.2   VirtualBox NAT: 10.0.2.2   VMware NAT: .2 of the subnet
HOST_FROM_GUEST="10.211.55.2"

# ---------- macOS guest (Apple Silicon; Parallels/VMware Fusion only) ----------
GUEST_mac_PROVIDER=parallels
GUEST_mac_OS=macos
GUEST_mac_ARCH=arm64
GUEST_mac_VMNAME="macOS"
GUEST_mac_IP=10.211.55.3
GUEST_mac_USER=labuser
GUEST_mac_AUTH=key
GUEST_mac_KEY="$HOME/.ssh/vmlab_ed25519"
GUEST_mac_PW=changeme
GUEST_mac_HOSTNAME="macos.local"
GUEST_mac_RESET_SNAPSHOT="clean"     # ./ctl.sh mac reset  -> restores this

# ---------- Windows guest (arm64 on Apple Silicon, or x64 on AMD/Intel) ----------
GUEST_win_PROVIDER=parallels
GUEST_win_OS=windows
GUEST_win_ARCH=arm64
GUEST_win_VMNAME="Windows 11"
GUEST_win_IP=10.211.55.4
GUEST_win_USER=labuser
GUEST_win_AUTH=key
GUEST_win_KEY="$HOME/.ssh/vmlab_ed25519"
GUEST_win_HOSTNAME="windows.local"

# ---------- Linux guest (x64 on AMD/Intel, or arm64 on Apple Silicon) ----------
GUEST_lin_PROVIDER=virtualbox
GUEST_lin_OS=linux
GUEST_lin_ARCH=x64
GUEST_lin_VMNAME="ubuntu-lab"
GUEST_lin_IP=
GUEST_lin_USER=labuser
GUEST_lin_AUTH=key
GUEST_lin_KEY="$HOME/.ssh/vmlab_ed25519"
GUEST_lin_PW=changeme
GUEST_lin_HOSTNAME="ubuntu-lab.local"

# The dedicated keypair used above (generate once, then seed into each guest via
# bootstrap/):  ssh-keygen -t ed25519 -f ~/.ssh/vmlab_ed25519 -C vmlab -N ''
